# URL of the slim recall dataset published by scripts/recall-ingest (see README).
# Leave unset during development to fall back to the bundled fictional sample dataset.
EXPO_PUBLIC_RECALL_DATASET_URL=

# RevenueCat public SDK keys. Leave unset to use the local Pro dev-stub toggle
# in Settings instead of real App Store / Play Billing purchases.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
