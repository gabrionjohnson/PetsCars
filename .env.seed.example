# Pathway Seed Script — environment variables
# Copy this file to .env.seed and fill in your values.
# .env.seed is gitignored — never commit real keys.
#
# Find these in: Supabase Dashboard → Project Settings → API
#
# SUPABASE_URL:              "Project URL"  (e.g. https://abcdefg.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: "service_role" key (NOT the anon key)
#   ⚠️  The service role key bypasses RLS — only use for local dev seeding.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
