{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".ts-out"
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["app", "node_modules", ".ts-out"]
}
